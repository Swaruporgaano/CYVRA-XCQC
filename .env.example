# CYVRA XCQC — local / Codespaces / Render env template
# Copy to .env for local API. Do not commit real secrets.

# --- API (apps/api) ---
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Optional shared secret for agent ingest (MVP). Leave empty to allow open local ingest.
XCQC_INGEST_TOKEN=dev-ingest-token

# Persistence mode for MVP: memory | file
# memory = process RAM only (lost on restart / Render sleep)
# file = JSON under DATA_DIR (survives local restarts; still not multi-instance safe)
XCQC_STORE=memory
DATA_DIR=./data

# Neon — create ONLY when you need durable multi-instance / prod persistence
# Apply apps/api/sql/neon-schema.sql after creating the project.
# DATABASE_URL=postgresql://USER:PASS@HOST/db?sslmode=require

# JWT / signing — required before real licenses & certificates
# JWT_SECRET=change-me
# LICENSE_SIGNING_KEY=change-me

# --- Web (apps/web) ---
# VITE_API_URL=http://127.0.0.1:8080
# VITE_INGEST_TOKEN=dev-ingest-token

# --- Windows agent / Electron ---
# XCQC_API_BASE_URL=http://127.0.0.1:8080
# XCQC_INGEST_TOKEN=dev-ingest-token
# XCQC_OPERATOR_ID=lab-operator
# XCQC_ORG_ID=lab-org
# XCQC_AGENT_EXE=C:\path\to\Xcqc.Agent.exe
