# CYVRA XCQC — local / Codespaces / Render env template
# Copy to .env for local API. Do not commit real secrets.

# --- API (apps/api) ---
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Optional shared secret for agent ingest (MVP lab/operator). Leave empty to allow open local ingest.
# Lab-only until L3 device JWT cutover — see docs/P0-VERIFICATION-CHECKLIST.md
XCQC_INGEST_TOKEN=dev-ingest-token

# Persistence mode when DATABASE_URL is NOT set:
#   memory = process RAM only (lost on restart / Render sleep) — default, Codespace-friendly
#   file   = JSON under DATA_DIR (survives local restarts; single-process only)
XCQC_STORE=memory
DATA_DIR=./data

# --- Neon (optional — API works without it) ---
# When DATABASE_URL is set, the API prefers Neon/Postgres for sessions/reports.
# Create a Neon project first — see docs/NEON-SETUP.md
# Use the *pooled* connection string (host contains -pooler).
# Apply schema: neon-schema.sql then neon-schema-l1-commercial.sql
# DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Auth / licensing (required for L2+) ---
# Generate strong random values (32+ bytes). Never commit real values.
JWT_SECRET=replace-with-random-32b-plus
OTP_PEPPER=replace-with-random-32b-plus
# LICENSE_PEPPER=replace-with-random-32b-plus

# L3 — always return full license key in issue response (dev)
LICENSE_DEV_MODE=true

# L2 — return OTP in API response + log to console (no SMS provider yet)
OTP_DEV_MODE=true
SMS_PROVIDER=console

# CORS — comma-separated origins or patterns (* wildcard). Merged with API defaults (*.workers.dev, *.cyvoriq.com)
# CORS_ORIGINS=https://cyvra-xcqc.orgaanoagrolab.workers.dev

# --- Web (apps/web) ---
# Local dev uses Vite proxy (/api → :8080). In Codespaces set to forwarded API URL.
# VITE_API_URL=http://127.0.0.1:8080
# VITE_INGEST_TOKEN=dev-ingest-token

# --- Windows agent / Electron (run on a physical Windows PC, not in Codespace) ---
# Point at local API, Codespace forwarded port, or Render deployment.
# XCQC_API_BASE_URL=http://127.0.0.1:8080
# XCQC_INGEST_TOKEN=dev-ingest-token
# XCQC_OPERATOR_ID=lab-operator
# XCQC_ORG_ID=lab-org
# XCQC_AGENT_EXE=C:\path\to\Xcqc.Agent.exe
